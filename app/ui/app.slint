// The launcher window. The .slint file only draws; pages, focus order and button handling live
// in Rust (src/pages.rs, src/vm/, src/focus.rs, ADR 0003). Keys become `Nav` through the `nav`
// callback; the controller reaches the same Rust handlers from src/input.rs.

component FocusButton inherits Rectangle {
    in property <string> label;
    in property <bool> focused;
    callback activated();

    height: 56px;
    border-radius: 8px;
    border-width: focused ? 3px : 1px;
    border-color: focused ? #f2b134 : #5a6270;
    background: focused ? #2d3544 : #1f2430;
    Text {
        text: root.label;
        color: white;
        font-size: 18px;
    }
    TouchArea {
        clicked => { root.activated(); }
    }
}

// One paired device, as src/vm/fleet.rs formats it.
export struct FleetRow {
    name: string,
    detail: string,
    sync: string,
    free: string,
}

component FleetRowView inherits Rectangle {
    in property <FleetRow> device;
    in property <bool> focused;
    callback activated();

    border-radius: 8px;
    border-width: focused ? 3px : 1px;
    border-color: focused ? #f2b134 : #2d3544;
    background: focused ? #2d3544 : #1a1f2a;
    HorizontalLayout {
        padding: 12px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            Text {
                text: root.device.name;
                color: white;
                font-size: 18px;
            }
            Text {
                text: root.device.detail;
                color: #c3cad6;
                font-size: 14px;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text {
                text: root.device.sync;
                color: #c3cad6;
                font-size: 14px;
                horizontal-alignment: right;
            }
            Text {
                text: root.device.free;
                color: #8a93a3;
                font-size: 14px;
                horizontal-alignment: right;
            }
        }
    }
    TouchArea {
        clicked => { root.activated(); }
    }
}

export component AppWindow inherits Window {
    title: "Uncharted Universal";
    min-width: 640px;
    min-height: 400px;
    preferred-width: 960px;
    preferred-height: 600px;
    background: #12151c;

    // 0 = home, 1 = Fleet (`Page` in src/pages.rs).
    in property <int> page: 0;
    in property <[string]> home-buttons;
    in property <int> focused-index: 0;
    in property <[FleetRow]> fleet-rows;
    in property <int> fleet-focus: 0;
    in property <int> fleet-back-index: 0;
    in property <string> fleet-warning;
    in property <string> fleet-empty;

    // 0 = Up, 1 = Down, 2 = Left, 3 = Right (see `Nav` in src/focus.rs).
    callback nav(int);
    // A (South), Return or Space on the focused item.
    callback activate();
    // A mouse click or touch on item <int> of the page shown.
    callback clicked(int);
    // B (East) or Escape.
    callback back();

    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.UpArrow) { root.nav(0); return accept; }
            if (event.text == Key.DownArrow) { root.nav(1); return accept; }
            if (event.text == Key.LeftArrow) { root.nav(2); return accept; }
            if (event.text == Key.RightArrow) { root.nav(3); return accept; }
            if (event.text == Key.Tab) { root.nav(1); return accept; }
            if (event.text == Key.Backtab) { root.nav(0); return accept; }
            if (event.text == Key.Return || event.text == " ") { root.activate(); return accept; }
            if (event.text == Key.Escape) { root.back(); return accept; }
            reject
        }

        if root.page == 0: VerticalLayout {
            padding: 24px;
            spacing: 16px;

            // Placeholder for the Continue screen (piece 2.04).
            Rectangle {
                vertical-stretch: 1;
                border-radius: 12px;
                background: #1a1f2a;
                Text {
                    text: "Continue screen goes here";
                    color: #8a93a3;
                    font-size: 22px;
                }
            }

            HorizontalLayout {
                spacing: 16px;
                for label[i] in root.home-buttons: FocusButton {
                    label: label;
                    focused: root.focused-index == i;
                    activated => { root.clicked(i); }
                }
            }

            // Slint's royalty-free licence asks for this notice.
            Text {
                text: "About: this application is built with Slint, used under the Slint Royalty-free Desktop, Mobile, and Web Applications licence (https://slint.dev).";
                color: #8a93a3;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        if root.page == 1: VerticalLayout {
            padding: 24px;
            spacing: 12px;

            Text {
                text: "Fleet";
                color: white;
                font-size: 26px;
            }

            if root.fleet-warning != "": Rectangle {
                border-radius: 8px;
                background: #4a3410;
                border-width: 1px;
                border-color: #f2b134;
                HorizontalLayout {
                    padding: 12px;
                    Text {
                        text: root.fleet-warning;
                        color: #ffe2a8;
                        font-size: 16px;
                        wrap: word-wrap;
                    }
                }
            }

            Flickable {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    spacing: 8px;
                    for row[i] in root.fleet-rows: FleetRowView {
                        device: row;
                        focused: root.fleet-focus == i;
                        activated => { root.clicked(i); }
                    }
                    if root.fleet-empty != "": Text {
                        text: root.fleet-empty;
                        color: #8a93a3;
                        font-size: 16px;
                        wrap: word-wrap;
                    }
                }
            }

            HorizontalLayout {
                alignment: start;
                FocusButton {
                    width: 160px;
                    label: "Back";
                    focused: root.fleet-focus == root.fleet-back-index;
                    activated => { root.clicked(root.fleet-back-index); }
                }
            }
        }
    }
}
