# French texts of the Uncharted Universal launcher (app/). English is the source:
# each msgid is the text as written in ui/app.slint (@tr) or src/ (texts.tr).
# src/lang.rs tests that this file has every text the app shows, and nothing else.
msgid ""
msgstr ""
"Project-Id-Version: uncharted-app\n"
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

