[Desktop Entry]
Type=Application
Name=Uncharted
Comment=Uncharted: The Nathan Drake Collection for Linux
Exec=AppRun
Icon=uncharted-linux
Terminal=false
Categories=Game;
Actions=classic;report;

[Desktop Action classic]
Name=Classic launcher
Exec=AppRun --classic

[Desktop Action report]
Name=Create bug report
Exec=AppRun --report
