<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.uncharted.universal.u3"
    android:versionCode="1"
    android:versionName="0.3.15">

    <!-- Matches android/components.lock.json (androidApi=33, sdkPlatform=35, arm64-v8a). -->
    <uses-sdk
        android:minSdkVersion="33"
        android:targetSdkVersion="35" />

    <!-- Home-network hub pairing, Stage 7.04 resumable Dropbox download, and Stage 7.05 save-relay. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Vulkan 1.1+ required; explicit Turnip or validated system driver is checked at startup. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x00401000"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />

    <!--
        android:extractNativeLibs="true" mirrors Gradle packaging.jniLibs.useLegacyPackaging=true,
        which android/driver_loader.cpp requires so libadrenotools can inject Turnip from
        nativeLibraryDir. Thin APK (M9): no bundled game assets.
    -->
    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:hasCode="false"
        android:label="Uncharted 3">

        <meta-data
            android:name="org.uncharted.game_id"
            android:value="u3" />

        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">

            <meta-data
                android:name="android.app.lib_name"
                android:value="uncharted_android_apk" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
